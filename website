      <div class="pack-label">Pcs — Trial Pack</div>
      <div class="pack-use">Perfect for Home Use</div>
      <div class="pack-sub">First-time users, family meals, small gatherings. Compact enough for any kitchen drawer.</div>
    </div>
    <div class="pack-card featured reveal reveal-delay-1">
      <div class="pack-tag">Most Popular</div>
      <div class="pack-count">48</div>
      <div class="pack-label">Pcs — Bulk Pack</div>
      <div class="pack-use">Home Parties & Events</div>
      <div class="pack-sub">The sweet spot for parties, small caterers, and household stocking. Best value for consumers.</div>
    </div>
    <div class="pack-card reveal reveal-delay-2">
      <div class="pack-count">500+</div>
      <div class="pack-label">Custom B2B Order</div>
      <div class="pack-use">Restaurants, Cafes, Hotels</div>
      <div class="pack-sub">Your logo, your design. Minimum 500 units. Custom dimensions, branded packaging, bulk pricing.</div>
    </div>
  </div>
  <p style="font-size:0.78rem;color:var(--muted);margin-top:2.5rem;letter-spacing:0.08em;" class="reveal">
    Size: 12 × 17 inches · Water resistant · Easy to clean · Protects surfaces · Durable quality
  </p>
</section>

<section class="cta-section">
  <p class="section-label" style="color:#8B6914">Ready to transform your dining experience?</p>
  <h2 class="section-title">The future of dining<br><em>starts at the table</em></h2>
  <p class="cta-sub">Whether you're a home user, a restaurant chain, or a brand looking to co-create — VI Mats is your partner in elevated, hygienic dining.</p>
  <div class="cta-btns">
    <button class="cta-btn-dark">Order Now</button>
    <button class="cta-btn-gold">Partner With Us</button>
  </div>
</section>

<footer>
  <div class="footer-logo">V·I Mats</div>
  <div class="footer-copy">© 2026 VI Mats · Kind to Your Table, Kind to the Planet</div>
  <div style="font-size:0.72rem;color:var(--muted);">Customer Care: 9999999999</div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const canvas = document.getElementById('three-canvas');
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
camera.position.set(0, 0.5, 5);

const ambient = new THREE.AmbientLight(0xfff5e0, 0.4);
scene.add(ambient);
const key = new THREE.DirectionalLight(0xc8a96e, 1.8);
key.position.set(3, 4, 3);
scene.add(key);
const fill = new THREE.DirectionalLight(0xe8d5a8, 0.6);
fill.position.set(-3, 1, 2);
scene.add(fill);
const rim = new THREE.DirectionalLight(0xffffff, 0.4);
rim.position.set(0, -2, -3);
scene.add(rim);

function createMatTexture() {
  const c = document.createElement('canvas');
  c.width = 512; c.height = 384;
  const ctx = c.getContext('2d');
  ctx.fillStyle = '#1C2A3A';
  ctx.fillRect(0, 0, 512, 384);
  const patternCanvas = document.createElement('canvas');
  patternCanvas.width = 8; patternCanvas.height = 8;
  const pCtx = patternCanvas.getContext('2d');
  pCtx.fillStyle = '#243447';
  pCtx.fillRect(0, 0, 8, 8);
  pCtx.fillStyle = '#1C2A3A';
  pCtx.fillRect(0, 0, 4, 4);
  pCtx.fillRect(4, 4, 4, 4);
  const pattern = ctx.createPattern(patternCanvas, 'repeat');
  ctx.fillStyle = pattern;
  ctx.globalAlpha = 0.7;
  ctx.fillRect(0, 0, 512, 384);
  ctx.globalAlpha = 1;
  ctx.strokeStyle = 'rgba(200,169,110,0.25)';
  ctx.lineWidth = 1;
  for (let i = -50; i < 600; i += 40) {
    for (let j = -50; j < 450; j += 40) {
      ctx.beginPath();
      ctx.moveTo(i, j + 20);
      ctx.lineTo(i + 20, j);
      ctx.lineTo(i + 40, j + 20);
      ctx.lineTo(i + 20, j + 40);
      ctx.closePath();
      ctx.stroke();
    }
  }
  ctx.strokeStyle = 'rgba(200,169,110,0.5)';
  ctx.lineWidth = 3;
  ctx.strokeRect(12, 9, 488, 366);
  ctx.strokeStyle = 'rgba(200,169,110,0.2)';
  ctx.lineWidth = 1;
  ctx.strokeRect(20, 15, 472, 354);
  ctx.fillStyle = 'rgba(200,169,110,0.9)';
  ctx.font = 'bold 36px serif';
  ctx.textAlign = 'center';
  ctx.fillText('V · I', 256, 175);
  ctx.font = '16px sans-serif';
  ctx.fillStyle = 'rgba(200,169,110,0.6)';
  ctx.fillText('M A T S', 256, 210);
  ctx.font = '11px sans-serif';
  ctx.fillStyle = 'rgba(200,169,110,0.4)';
  ctx.fillText('PROTECTS · DECORATES · ELEGANT', 256, 240);
  return new THREE.CanvasTexture(c);
}

const matTexture = createMatTexture();
const matGroup = new THREE.Group();

const matGeo = new THREE.BoxGeometry(3.4, 0.04, 2.55, 8, 1, 6);
const matMat = new THREE.MeshStandardMaterial({ map: matTexture, roughness: 0.7, metalness: 0.1 });
const mat = new THREE.Mesh(matGeo, matMat);
matGroup.add(mat);

const edgeMat = new THREE.MeshStandardMaterial({ color: 0xc8a96e, metalness: 0.7, roughness: 0.3 });
const eTop = new THREE.Mesh(new THREE.BoxGeometry(3.4, 0.045, 0.04), edgeMat);
eTop.position.set(0, 0.001, -1.255); matGroup.add(eTop);
const eBot = new THREE.Mesh(new THREE.BoxGeometry(3.4, 0.045, 0.04), edgeMat);
eBot.position.set(0, 0.001, 1.255); matGroup.add(eBot);
const eL = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.045, 2.55), edgeMat);
eL.position.set(-1.68, 0.001, 0); matGroup.add(eL);
const eR = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.045, 2.55), edgeMat);
eR.position.set(1.68, 0.001, 0); matGroup.add(eR);

for (let i = 1; i <= 3; i++) {
  const stackMat = new THREE.Mesh(
    new THREE.BoxGeometry(3.4, 0.04, 2.55),
    new THREE.MeshStandardMaterial({ color: 0x1a2535, roughness: 0.8 })
  );
  stackMat.position.set(0.02 * i, -0.04 * i, -0.02 * i);
  matGroup.add(stackMat);
}
scene.add(matGroup);

const particles = new THREE.BufferGeometry();
const count = 80;
const positions = new Float32Array(count * 3);
for (let i = 0; i < count * 3; i++) { positions[i] = (Math.random() - 0.5) * 12; }
particles.setAttribute('position', new THREE.BufferAttribute(positions, 3));
const particleMat = new THREE.PointsMaterial({ color: 0xc8a96e, size: 0.015, transparent: true, opacity: 0.4 });
const particleSystem = new THREE.Points(particles, particleMat);
scene.add(particleSystem);

let scrollY = 0;
let targetRotX = 0.15, targetRotY = 0;
let currentRotX = 0.15, currentRotY = 0;
let mouseX = 0, mouseY = 0;

window.addEventListener('scroll', () => {
  scrollY = window.scrollY;
  const heroH = document.getElementById('hero').offsetHeight;
  const progress = Math.min(scrollY / heroH, 1);
  targetRotX = 0.15 + progress * Math.PI * 0.6;
  targetRotY = progress * Math.PI * 1.2;
});

window.addEventListener('mousemove', (e) => {
  mouseX = (e.clientX / window.innerWidth - 0.5) * 0.5;
  mouseY = (e.clientY / window.innerHeight - 0.5) * 0.2;
});

const clock = new THREE.Clock();

function animate() {
  requestAnimationFrame(animate);
  const t = clock.getElapsedTime();
  const inHero = scrollY < document.getElementById('hero').offsetHeight * 0.5;
  if (inHero) {
    matGroup.position.y = Math.sin(t * 0.8) * 0.08;
    currentRotX += (0.15 + mouseY * 0.3 - currentRotX) * 0.04;
    currentRotY += (mouseX * 0.5 + t * 0.15 - currentRotY) * 0.03;
  } else {
    currentRotX += (targetRotX - currentRotX) * 0.05;
    currentRotY += (targetRotY - currentRotY) * 0.05;
  }
  matGroup.rotation.x = currentRotX;
  matGroup.rotation.y = currentRotY;
  particleSystem.rotation.y = t * 0.02;
  particleSystem.rotation.x = t * 0.01;
  renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

const reveals = document.querySelectorAll('.reveal');
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.12 });
reveals.forEach(r => observer.observe(r));
</script>
</body>
</html>

