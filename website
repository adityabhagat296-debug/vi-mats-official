<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VI Mats — Elevate Every Table</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --cream: #F5F0E8;
    --ink: #1A1714;
    --gold: #C8A96E;
    --gold-light: #E8D5A8;
    --muted: #7A7268;
    --navy: #1C2A3A;
    --white: #FDFAF5;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--ink);
    color: var(--cream);
    font-family: 'DM Sans', sans-serif;
    overflow-x: hidden;
  }

  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.5rem 3rem;
    background: linear-gradient(to bottom, rgba(26,23,20,0.95), transparent);
  }
  .nav-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem; font-weight: 600; letter-spacing: 0.12em;
    color: var(--gold);
  }
  .nav-logo span { font-style: italic; color: var(--cream); }
  .nav-links { display: flex; gap: 2.5rem; list-style: none; }
  .nav-links a {
    font-size: 0.8rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--cream); text-decoration: none; opacity: 0.7;
    transition: opacity 0.3s;
  }
  .nav-links a:hover { opacity: 1; color: var(--gold); }
  .nav-cta {
    background: var(--gold); color: var(--ink);
    padding: 0.6rem 1.6rem; font-size: 0.75rem;
    letter-spacing: 0.12em; text-transform: uppercase;
    border: none; cursor: pointer; font-weight: 500;
    transition: background 0.3s;
  }
  .nav-cta:hover { background: var(--gold-light); }

  .hero {
    height: 100vh;
    display: flex; flex-direction: column;
    justify-content: center; align-items: center;
    position: relative; overflow: hidden;
  }

  #three-canvas {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
  }

  .hero-content {
    position: relative; z-index: 2;
    text-align: center; pointer-events: none;
  }

  .hero-eyebrow {
    font-size: 0.72rem; letter-spacing: 0.3em;
    text-transform: uppercase; color: var(--gold);
    margin-bottom: 1.5rem; opacity: 0;
    animation: fadeUp 0.8s 0.3s forwards;
  }

  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 300; line-height: 1.0;
    letter-spacing: 0.02em;
    opacity: 0;
    animation: fadeUp 0.9s 0.5s forwards;
  }

  .hero-title em {
    font-style: italic; color: var(--gold);
    display: block;
  }

  .hero-sub {
    font-size: 0.9rem; letter-spacing: 0.08em;
    color: var(--muted); margin-top: 1.5rem;
    font-weight: 300;
    opacity: 0;
    animation: fadeUp 0.9s 0.8s forwards;
  }

  .hero-btns {
    display: flex; gap: 1rem; justify-content: center;
    margin-top: 2.5rem;
    opacity: 0;
    animation: fadeUp 0.9s 1.1s forwards;
    pointer-events: all;
  }

  .btn-primary {
    background: var(--gold); color: var(--ink);
    padding: 0.9rem 2.4rem; font-size: 0.78rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    border: none; cursor: pointer; font-weight: 500;
    transition: all 0.3s;
  }
  .btn-primary:hover { background: var(--gold-light); transform: translateY(-2px); }

  .btn-outline {
    background: transparent; color: var(--cream);
    padding: 0.9rem 2.4rem; font-size: 0.78rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    border: 1px solid rgba(200,169,110,0.4); cursor: pointer; font-weight: 400;
    transition: all 0.3s;
  }
  .btn-outline:hover { border-color: var(--gold); color: var(--gold); transform: translateY(-2px); }

  .scroll-hint {
    position: absolute; bottom: 2.5rem; left: 50%; transform: translateX(-50%);
    z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    opacity: 0; animation: fadeUp 1s 1.5s forwards;
    pointer-events: none;
  }
  .scroll-hint span {
    font-size: 0.65rem; letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--muted);
  }
  .scroll-line {
    width: 1px; height: 40px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  section { padding: 7rem 3rem; position: relative; }

  .section-label {
    font-size: 0.68rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 1rem;
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 300; line-height: 1.15;
  }

  .intro-section {
    background: var(--cream); color: var(--ink);
    display: grid; grid-template-columns: 1fr 1fr; gap: 5rem;
    align-items: center;
  }
  .intro-section .section-label { color: #8B6914; }

  .intro-quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-style: italic; font-weight: 300;
    line-height: 1.35; color: var(--navy);
  }

  .intro-stats {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;
    margin-top: 3rem;
  }

  .stat-card { border-top: 1px solid rgba(26,23,20,0.15); padding-top: 1.2rem; }
  .stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.8rem; font-weight: 300; color: #8B6914; line-height: 1;
  }
  .stat-label { font-size: 0.78rem; letter-spacing: 0.05em; color: #6A6058; margin-top: 0.4rem; line-height: 1.5; }

  .features-section { background: var(--ink); }
  .features-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px;
    margin-top: 4rem;
    border: 1px solid rgba(200,169,110,0.15);
  }
  .feature-card {
    padding: 2.5rem 2rem;
    border-right: 1px solid rgba(200,169,110,0.15);
    transition: background 0.4s;
  }
  .feature-card:last-child { border-right: none; }
  .feature-card:hover { background: rgba(200,169,110,0.06); }
  .feature-num { font-family: 'Cormorant Garamond', serif; font-size: 1rem; color: var(--gold); opacity: 0.5; margin-bottom: 1.5rem; }
  .feature-title { font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; font-weight: 400; margin-bottom: 0.8rem; }
  .feature-desc { font-size: 0.82rem; color: var(--muted); line-height: 1.7; font-weight: 300; }

  .how-section { background: #120F0D; text-align: center; }
  .steps-row {
    display: flex; justify-content: center; align-items: stretch;
    gap: 0; margin-top: 5rem; position: relative;
  }
  .step { flex: 1; max-width: 220px; padding: 2rem 1.5rem; position: relative; text-align: center; }
  .step::after {
    content: '→'; position: absolute; right: -12px; top: 50%;
    transform: translateY(-60%); color: var(--gold); opacity: 0.4;
    font-size: 1.2rem; z-index: 1;
  }
  .step:last-child::after { display: none; }
  .step-icon {
    width: 60px; height: 60px;
    border: 1px solid rgba(200,169,110,0.3); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.5rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem; color: var(--gold); transition: all 0.3s;
  }
  .step:hover .step-icon { background: var(--gold); color: var(--ink); border-color: var(--gold); }
  .step-title { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.6rem; }
  .step-desc { font-size: 0.78rem; color: var(--muted); line-height: 1.6; }

  .market-section { background: var(--cream); color: var(--ink); }
  .market-section .section-label { color: #8B6914; }
  .market-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 3rem; margin-top: 4rem; }
  .market-card {
    padding: 2.5rem; border: 1px solid rgba(26,23,20,0.1);
    position: relative; overflow: hidden;
  }
  .market-card::before {
    content: ''; position: absolute; top: 0; left: 0;
    width: 3px; height: 100%; background: var(--gold);
  }
  .market-segment { font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: #8B6914; margin-bottom: 0.8rem; }
  .market-name { font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; font-weight: 400; margin-bottom: 0.5rem; }
  .market-size { font-family: 'Cormorant Garamond', serif; font-size: 2.5rem; color: var(--navy); font-weight: 300; }
  .market-detail { font-size: 0.8rem; color: #6A6058; margin-top: 0.8rem; line-height: 1.6; }

  .trust-section { background: var(--navy); text-align: center; }
  .trust-badges { display: flex; justify-content: center; flex-wrap: wrap; gap: 1.5rem; margin-top: 3.5rem; }
  .badge {
    border: 1px solid rgba(200,169,110,0.3); padding: 1rem 2rem;
    font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase;
    transition: all 0.3s; display: flex; align-items: center; gap: 0.6rem;
  }
  .badge:hover { border-color: var(--gold); background: rgba(200,169,110,0.08); }
  .badge-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); }

  .pack-section { background: var(--ink); }
  .pack-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 4rem; }
  .pack-card {
    background: rgba(255,255,255,0.03); border: 1px solid rgba(200,169,110,0.12);
    padding: 2.5rem 2rem; text-align: center; transition: all 0.4s; position: relative;
  }
  .pack-card.featured { border-color: var(--gold); background: rgba(200,169,110,0.06); }
  .pack-tag {
    position: absolute; top: -1px; left: 50%; transform: translateX(-50%);
    background: var(--gold); color: var(--ink);
    font-size: 0.62rem; letter-spacing: 0.15em; padding: 0.25rem 1rem;
    text-transform: uppercase; font-weight: 500;
  }
  .pack-count { font-family: 'Cormorant Garamond', serif; font-size: 4rem; font-weight: 300; color: var(--gold); line-height: 1; }
  .pack-label { font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin: 0.5rem 0 1.5rem; }
  .pack-use { font-size: 0.82rem; color: var(--cream); margin-bottom: 0.5rem; }
  .pack-sub { font-size: 0.76rem; color: var(--muted); line-height: 1.5; }

  .cta-section { background: var(--cream); color: var(--ink); text-align: center; padding: 8rem 3rem; }
  .cta-section .section-title { font-size: clamp(3rem, 6vw, 5.5rem); }
  .cta-section em { font-style: italic; color: #8B6914; }
  .cta-sub { font-size: 1rem; color: #6A6058; margin: 1.5rem auto; max-width: 480px; line-height: 1.7; }
  .cta-btns { display: flex; gap: 1rem; justify-content: center; margin-top: 3rem; }
  .cta-btn-dark {
    background: var(--ink); color: var(--cream);
    padding: 1rem 3rem; font-size: 0.8rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    border: none; cursor: pointer; font-weight: 400; transition: all 0.3s;
  }
  .cta-btn-dark:hover { background: var(--navy); transform: translateY(-2px); }
  .cta-btn-gold {
    background: transparent; color: #8B6914;
    padding: 1rem 3rem; font-size: 0.8rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    border: 1px solid #8B6914; cursor: pointer; transition: all 0.3s;
  }
  .cta-btn-gold:hover { background: #8B6914; color: var(--cream); transform: translateY(-2px); }

  footer {
    background: #0D0B09; padding: 3rem;
    display: flex; justify-content: space-between; align-items: center;
    border-top: 1px solid rgba(200,169,110,0.1);
  }
  .footer-logo { font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; color: var(--gold); }
  .footer-copy { font-size: 0.72rem; color: var(--muted); }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  .reveal { opacity: 0; transform: translateY(32px); transition: opacity 0.8s ease, transform 0.8s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }

  .divider { width: 60px; height: 1px; background: var(--gold); margin: 2rem 0; }
  .divider-center { margin: 2rem auto; }
</style>
</head>
<body>

